# Salin file ini ke `.env` untuk dev lokal. Untuk image Docker production,
# salin ke `.env.prod` lalu isi nilai production sebelum build.

# Public resource directory
NEXT_PUBLIC_ASSETS_DIR=

# Galeri komponen internal — hanya untuk development.
# Saat `yarn dev` galeri selalu tampil; di build production hanya tampil
# bila flag ini true. Deploy client: biarkan kosong → seluruh /components 404.
NEXT_PUBLIC_SHOW_COMPONENTS=true

# Optional data API URL untuk integrasi eksternal.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Optional server-only override untuk akses internal. Falls back to the public URL.
# API_URL=http://localhost:8080

# Tenant identifier for an optional external data API.
NEXT_PUBLIC_COMPANY_SLUG=sakuflow

# Optional client identifier for an external data API.
NEXT_PUBLIC_CLIENT_SLUG=sakuflow

# Public site origin — canonical URLs, Open Graph, sitemap.xml, robots.txt
NEXT_PUBLIC_SITE_URL=http://localhost:8002

# Server-only: bearer token webhook POST /api/revalidate (min 16 karakter) —
# backend/CMS memanggilnya saat konten berubah supaya cache ISR langsung segar.
# Kosongkan untuk menonaktifkan endpoint.
# REVALIDATE_TOKEN=

# Optional server-only OpenAI-compatible adapter. AI_API_URL is a base URL
# (for example https://provider.example/v1); SakuFlow appends /chat/completions.
# When absent, transaction parsing stays entirely deterministic and local.
# AI_API_URL=
# AI_API_KEY=
AI_MODEL=default
